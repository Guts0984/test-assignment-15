# Copy to .env (cp .env.example .env). Values marked DEV-ONLY are placeholders for local use,
# never use them anywhere real.

# ---- general -------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
# Host port where nginx (the single entry point) listens.
HTTP_PORT=8080

# ---- postgres (SENSITIVE) --------------------------------------------------
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=helpdesk
# Host ports where compose publishes postgres and redis (127.0.0.1 only) for tests and tooling.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
# Connection string used by api, worker, seed and tests. Contains the password.
DATABASE_URL=postgresql://helpdesk:dev-only-postgres-password@postgres:5432/helpdesk

# ---- redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ---- api -------------------------------------------------------------------
API_PORT=3000
# Copy name shown in X-Api-Instance and logs; compose sets api-1 / api-2.
API_INSTANCE_ID=api
# Base URL used in links inside emails.
PUBLIC_BASE_URL=http://localhost:8080
# Comma separated CORS allowlist.
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Proxies whose X-Forwarded-For is trusted (the docker network nginx lives in).
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8
JSON_BODY_LIMIT_BYTES=1048576
# Total decoded attachment size per message (10 MB).
MAX_ATTACHMENTS_BYTES=10485760

# ---- auth (SENSITIVE) ------------------------------------------------------
# HS256 key for access tokens, at least 32 characters. DEV-ONLY value.
JWT_ACCESS_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
MAGIC_LINK_TTL_DAYS=30
SURVEY_TTL_DAYS=7

# ---- business timing -------------------------------------------------------
AUTO_CLOSE_AFTER_HOURS=72
UNDO_SEND_SECONDS=10
SLA_WARNING_RATIO=0.8
SHIFT_OFF_REPLY_WINDOW_MINUTES=60

# ---- inbound mail (SENSITIVE) ----------------------------------------------
# HMAC key shared by mail-stub and api for the inbound webhook. DEV-ONLY value.
INBOUND_WEBHOOK_SECRET=dev-only-inbound-secret-0123456789abcdef
INBOUND_SIGNATURE_TOLERANCE_SECONDS=300
MAIL_DOMAIN=helpdesk.test

# ---- outbound mail ---------------------------------------------------------
SMTP_HOST=mail-stub
SMTP_PORT=1025
SMTP_FROM_NAME="Helpdesk Support"

# ---- worker ----------------------------------------------------------------
WORKER_CONCURRENCY=10
# Number of worker copies docker compose starts (3 for the full invariant checks).
WORKER_REPLICAS=1
RECONCILE_INTERVAL_MS=250
RECONCILE_HORIZON_MS=600000
JOB_MAX_ATTEMPTS=8
JOB_BACKOFF_BASE_MS=1000
JOB_BACKOFF_MAX_MS=300000
OUTBOUND_LEASE_MS=60000

# ---- realtime --------------------------------------------------------------
PRESENCE_TTL_SECONDS=30
PRESENCE_HEARTBEAT_SECONDS=10
SOCKET_PING_INTERVAL_MS=10000
SOCKET_PING_TIMEOUT_MS=10000
# Max client->server socket events per second per connection (never keyed by IP).
SOCKET_EVENT_BUDGET_PER_SECOND=20

# ---- test control ----------------------------------------------------------
# Shared controllable clock. MUST stay false in the default profile; docker-compose.test.yml sets true.
TEST_CLOCK_ENABLED=false
# Guards POST /api/v1/test/clock when the flag above is true (SENSITIVE). DEV-ONLY value.
TEST_CONTROL_TOKEN=dev-only-test-control-token

# ---- seed ------------------------------------------------------------------
# full = 200k customers / 500k tickets / 3M messages; small = CI profile; none = empty.
SEED_PROFILE=full
SEED_RANDOM_SEED=42
SEED_RESET=false
# Password of every demo staff account (SENSITIVE). DEV-ONLY value, listed in the README.
SEED_STAFF_PASSWORD=Passw0rd-demo!

# ---- mail stub -------------------------------------------------------------
MAIL_STUB_SMTP_PORT=1025
MAIL_STUB_HTTP_PORT=8025
# Host port where the mail stub page is published.
MAIL_STUB_HOST_PORT=8025
MAIL_STUB_INBOUND_URL=http://nginx/api/v1/inbound/mail
MAIL_STUB_MAX_MESSAGES=50000
# Like a real mailbox provider, the stub acknowledges but does not store a repeated Message-ID for the same recipients,
# which is what makes a send that was repeated after a worker crash invisible to the customer.
MAIL_STUB_DEDUPE_MESSAGE_ID=true
# Chaos mode: duplicate inbound delivery, 451 on every Nth outbound, random autoreplies/bounces.
MAIL_CHAOS=false
MAIL_CHAOS_SMTP_FAIL_EVERY=10
MAIL_CHAOS_AUTOREPLY_RATE=0.1
MAIL_CHAOS_SEED=1

# ---- web -------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_PATH=/api/v1
NEXT_PUBLIC_SOCKET_PATH=/socket.io
NEXT_PUBLIC_UNDO_SEND_SECONDS=10
# Server-side (Next.js server) address of the api behind nginx.
WEB_INTERNAL_API_URL=http://nginx

# ---- tests -----------------------------------------------------------------
# Integration tests run on the host against the published compose ports (database is created by the tests).
TEST_DATABASE_URL=postgresql://helpdesk:dev-only-postgres-password@localhost:5433/helpdesk_test
TEST_REDIS_URL=redis://localhost:6380
E2E_BASE_URL=http://localhost:8080
# Direct api copies, published only by docker-compose.test.yml.
E2E_API_1_URL=http://localhost:3101
E2E_API_2_URL=http://localhost:3102
E2E_MAIL_STUB_URL=http://localhost:8025

# Direct connection to the compose database for the stack test suites (assertions only).
STACK_DATABASE_URL=postgresql://helpdesk:dev-only-postgres-password@localhost:5433/helpdesk
STACK_REDIS_URL=redis://localhost:6380
