{
  "name": "@helpdesk/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run -c vitest.serial.config.ts",
    "start": "node dist/main.js",
    "seed": "node dist/cli/migrate-and-seed.js",
    "openapi:emit": "node --env-file=../../.env dist/cli/emit-openapi.js"
  },
  "dependencies": {
    "@helpdesk/core": "workspace:*",
    "@helpdesk/shared": "workspace:*",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "argon2": "^0.45.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.18",
    "nestjs-zod": "^5.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@prisma/client": "^6.19.3",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "prisma": "^6.19.3",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  }
